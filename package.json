{
  "name": "pokemon-usage-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --import ./test/helpers/register.mjs test/*.test.mjs",
    "validate:calibration": "node --test --import ./test/helpers/register.mjs test/calibration/*.test.mjs",
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "build:resolver-index": "node scripts/build-resolver-index.mjs",
    "build:set-index": "node scripts/build-set-index.mjs",
    "build:reborn-legal-moves": "node scripts/build-reborn-legal-moves.mjs",
    "build:progression-species": "node scripts/build-progression-species.mjs",
    "build:held-items": "node scripts/build-held-items.mjs",
    "build:unburden-species": "node scripts/build-unburden-species.mjs",
    "build:base-stats": "node scripts/build-base-stats.mjs",
    "build:move-meta": "node scripts/build-move-meta.mjs",
    "build:item-damage": "node scripts/build-item-damage.mjs",
    "build:gen5-items": "node scripts/build-gen5-items.mjs",
    "build:item-timeline": "node scripts/build-item-timeline.mjs",
    "build:teammate-index": "node scripts/build-teammate-index.mjs",
    "build:observed-sets": "node scripts/build-observed-sets.mjs",
    "build:core-index": "node scripts/build-core-index.mjs",
    "build:team-index": "node scripts/build-team-index.mjs",
    "report:teams": "node scripts/report-team-corpus.mjs",
    "scrape:teams": "node scripts/scrape-replay-teams.mjs && node scripts/scrape-sample-teams.mjs && node scripts/scrape-rmt-teams.mjs && node scripts/scrape-tournament-teams.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:site": "node scripts/build-manifest.mjs && npm run build && node scripts/copy-data.mjs",
    "refresh:data": "npm run build:data -- --refresh-current && npm run build:resolver-index && npm run build:set-index && npm run build:move-meta && npm run build:item-damage && npm run build:reborn-legal-moves && npm run build:progression-species && npm run build:held-items && npm run build:unburden-species && npm run build:base-stats && npm run build:gen5-items && npm run build:teammate-index && npm run build:observed-sets && npm run build:core-index && npm run build:team-index",
    "dev:bg": "nohup npm run dev > /tmp/pokemon-vite.log 2>&1 &",
    "dev:log": "tail -50 /tmp/pokemon-vite.log",
    "dev:stop": "pkill -f 'vite --port 5173' || true",
    "e2e": "node scripts/run-e2e.mjs",
    "lint": "eslint src scripts test"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.7.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@pkmn/dex": "^0.10.7"
  }
}
