{
  "name": "pokemon-usage-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "build:resolver-index": "node scripts/build-resolver-index.mjs",
    "build:set-index": "node scripts/build-set-index.mjs",
    "build:reborn-legal-moves": "node scripts/build-reborn-legal-moves.mjs",
    "build:site": "npm run build && node scripts/copy-data.mjs",
    "refresh:data": "npm run build:data -- --refresh-current && npm run build:resolver-index && npm run build:set-index && npm run build:reborn-legal-moves",
    "dev:bg": "nohup npm run dev > /tmp/pokemon-vite.log 2>&1 &",
    "dev:log": "tail -50 /tmp/pokemon-vite.log",
    "dev:stop": "pkill -f 'vite --port 5173' || true"
  },
  "devDependencies": {
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@pkmn/dex": "^0.10.7"
  }
}
